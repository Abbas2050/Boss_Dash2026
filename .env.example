# MT5 API Configuration (Production)
# In production, set this to your PHP backend URL
# Example: https://yourdomain.com/mt5_api.php
VITE_MT5_API_URL=

# Base backend URL (used for SignalR + backend API endpoints in dev/proxy bypass cases)
# Example: https://api.skylinkscapital.com
VITE_BACKEND_BASE_URL=

# CRM / wallet / AI secrets -- SERVER-SIDE ONLY, no VITE_ prefix.
#
# Vite publishes every VITE_-prefixed variable to the browser bundle, so the
# prefix must never appear on a credential. These are read by server.js, which
# attaches the CRM token to the authenticated /rest proxy on the browser's
# behalf. Renaming any of these back to VITE_* re-opens the leak.
#
# Example: https://portal.skylinkscapital.com/rest/transactions
# API_TOKEN and API_VERSION are also read by the CRM events webhook, for the
# `first_deposit` stage only: it fetches the deposit amount from FXBO because
# Meta DISCARDS a Purchase that carries no value -- it answers 200 and throws
# the event away. Unset, that one stage records `failed` naming this variable;
# every other stage is unaffected. See the block at the end of this file.
API_URL=
API_VERSION=1.0.0
API_TOKEN=
WALLET_URL=
WALLET_TOKEN=
WALLET_API_TOKEN=
# **This is the LLM agent's key** (agent/llmAgent.js, the client-profiling
# summaries). It is NOT the ChatGPT Ads conversions key: that one is
# OPENAI_CONVERSIONS_API_KEY, in the "CRM events webhook" block at the end of
# this file, and the two are different credentials for different OpenAI
# products. Pasting one into the other's line costs you an afternoon --
# conversions stop and nothing errors -- which is exactly the mistake that made
# BREVO_LIST_ID fail open.
OPENAI_API_KEY=
# Where the /rest proxy forwards to. Defaults to portal.skylinkscapital.com.
# Also where the CRM events webhook looks a first deposit amount up, so the two
# can never disagree about which host the CRM is.
# REST_PROXY_TARGET=

# Wallet report notifications (email + Telegram)
# BREVO_API_KEY=
# EMAIL_FROM=noreply@skylinkscapital.com
# BREVO_API_KEY=
# DEALMATCH_ALERT_RECIPIENTS=you@company.com,team@company.com
# WEEKLY_DEALMATCH_ENABLED=true
# WEEKLY_DEALMATCH_CRON=0 9 * * 6
# WEEKLY_DEALMATCH_TIMEZONE=Asia/Dubai
# WEEKLY_DEALMATCH_RUN_ON_START=false
# WALLET_RECIPIENTS=ops@example.com,finance@example.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=-1000000000000
#
# Wallet scheduler modes:
# - daily (default): sends once daily at WALLET_REPORT_CRON (UTC)
# - on-change: checks balances on WALLET_REPORT_ON_CHANGE_CRON and sends only when tracked balances/total change
# WALLET_REPORT_MODE=daily
# WALLET_REPORT_CRON=0 8 * * *
# WALLET_REPORT_ON_CHANGE_CRON=*/5 * * * *
# WALLET_REPORT_RUN_ON_START=true
# WALLET_REPORT_SEND_ON_FIRST_RUN=false
# WALLET_REPORT_STATE_FILE=storage/wallet_report_state.json

# Server-side GA4 settings (used by server.js/api.js/ga4.js)
# GA4_PROPERTY_ID=476328175
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional fallback: file path on server (not committed)
# GA4_KEY_FILE=/absolute/path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# DEBUG_GA4=0

# FAB Operating / Holding balances for the Excess Funds cards.
# A SEPARATE workbook from GOOGLE_SHEETS_ID -- unrelated sheet, unrelated layout.
# It is read with the same service account (GA4_SERVICE_ACCOUNT_JSON), so the
# sheet must be shared with that account's client_email as a Viewer or the read
# fails with a 403 naming the address.
# The tab and the two cell addresses live in storage/fab_accounts_mapping.json,
# so a row inserted in the sheet is fixed by editing config, not by deploying.
# FAB_ACCOUNTS_SHEET_ID=

# Server-side auth DB + JWT
# AUTH_DB_HOST=localhost
# AUTH_DB_PORT=3306
# AUTH_DB_NAME=bossdash_auth
# AUTH_DB_USER=bossdash_user
# AUTH_DB_PASSWORD=change_me
# AUTH_JWT_SECRET=replace_with_long_random_secret
# AUTH_JWT_EXPIRES_IN=12h
# AUTH_SEED_NAME=Abbas
# AUTH_SEED_EMAIL=abbas@skylinks.capital
# AUTH_SEED_PASSWORD=admin123

# DocuSign integration (FXBO approved application -> envelope send)
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# DOCUSIGN_TEMPLATE_ID=
# DOCUSIGN_TEMPLATE_ROLE=Signer
# DOCUSIGN_EMAIL_SUBJECT=Please sign your application document
# DOCUSIGN_AUTH_BASE=account-d.docusign.com
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_BASE_URI=
# DOCUSIGN_FXBO_WEBHOOK_BEARER=
# DOCUSIGN_CONNECT_HMAC_SECRET=
# DOCUSIGN_AUTO_SYNC_ENABLED=false
# DOCUSIGN_AUTO_SYNC_INTERVAL_SECONDS=300
# DOCUSIGN_AUTO_SYNC_RUN_ON_START=true
# DOCUSIGN_SYNC_LOOKBACK_MINUTES=6

# Optional: If you want to override the default MT5 server settings
# These are already configured in mt5_api.php, but you can override them here
# MT5_SERVER=mt5.skylinkstrader.com:443
# MT5_LOGIN=1023
# MT5_BUILD=4330

# Weekly Slippage Report -- LP slippage buckets across trading pairs. Also
# backs the daily and monthly Slippage cadences (reports/schedulers.js):
# their _RECIPIENTS vars fall back to this one, so without it all three
# Slippage cadences have no recipients.
# WITHOUT SLIPPAGE_ALERT_RECIPIENTS THE REPORT SILENTLY SKIPS: the scheduler
# fires, logs "No recipients configured", and sends nothing.
# SLIPPAGE_ALERT_RECIPIENTS=you@company.com,team@company.com
# WEEKLY_SLIPPAGE_ENABLED=true
# WEEKLY_SLIPPAGE_CRON=30 9 * * 6
# WEEKLY_SLIPPAGE_TIMEZONE=Asia/Dubai
# WEEKLY_SLIPPAGE_RUN_ON_START=false

# Weekly Business Summary -- money movement and account activity.
# WITHOUT SUMMARY_ALERT_RECIPIENTS THE REPORT SILENTLY SKIPS: the scheduler
# fires, logs "No recipients configured", and sends nothing.
# SUMMARY_ALERT_RECIPIENTS=you@company.com,team@company.com
# WEEKLY_SUMMARY_ENABLED=true
# WEEKLY_SUMMARY_CRON=0 10 * * 6
# WEEKLY_SUMMARY_TIMEZONE=Asia/Dubai
# WEEKLY_SUMMARY_RUN_ON_START=false
# SUMMARY_LARGE_DEPOSIT_THRESHOLD=1000
# SUMMARY_TX_STATUSES=approved

# ── Report schedules ────────────────────────────────────────────────────────
# Three reports x three cadences. Times are Asia/Dubai. Ordering within a
# cadence is deliberate: Deal Match, then Slippage, then Business Summary --
# the Business Summary computes Total Revenue from DealMatch/Run and must not
# run first.
#
# Dailies run Tue-Sat (cron 2-6), each covering the previous day, so every
# trading day gets one daily and nothing fires for a shut market.
# Monthlies run after the weeklies so a 1st that falls on a Saturday does not
# fire two reports in the same minute.
#
# Every _RECIPIENTS below falls back to that report's *_ALERT_RECIPIENTS
# (DEALMATCH_ALERT_RECIPIENTS / SLIPPAGE_ALERT_RECIPIENTS /
# SUMMARY_ALERT_RECIPIENTS, set above), so all six here work with no change
# to this file once the ALERT_RECIPIENTS vars are set. The three weekly
# cadences (WEEKLY_DEALMATCH_*, WEEKLY_SLIPPAGE_*, WEEKLY_SUMMARY_*,
# documented above) have no dedicated _RECIPIENTS var and use the
# ALERT_RECIPIENTS vars directly -- so all nine work off the same three
# ALERT_RECIPIENTS settings.

# DAILY_DEALMATCH_ENABLED=true
# DAILY_DEALMATCH_CRON=0 7 * * 2-6
# DAILY_DEALMATCH_TIMEZONE=Asia/Dubai
# DAILY_DEALMATCH_RUN_ON_START=false
# DAILY_DEALMATCH_RECIPIENTS=

# DAILY_SLIPPAGE_ENABLED=true
# DAILY_SLIPPAGE_CRON=30 7 * * 2-6
# DAILY_SLIPPAGE_TIMEZONE=Asia/Dubai
# DAILY_SLIPPAGE_RUN_ON_START=false
# DAILY_SLIPPAGE_RECIPIENTS=

# DAILY_DIGEST_ENABLED=true
# DAILY_DIGEST_CRON=0 8 * * 2-6
# DAILY_DIGEST_TIMEZONE=Asia/Dubai
# DAILY_DIGEST_RUN_ON_START=false
# DAILY_DIGEST_RECIPIENTS=

# MONTHLY_DEALMATCH_ENABLED=true
# MONTHLY_DEALMATCH_CRON=0 11 1 * *
# MONTHLY_DEALMATCH_TIMEZONE=Asia/Dubai
# MONTHLY_DEALMATCH_RUN_ON_START=false
# MONTHLY_DEALMATCH_RECIPIENTS=

# MONTHLY_SLIPPAGE_ENABLED=true
# MONTHLY_SLIPPAGE_CRON=30 11 1 * *
# MONTHLY_SLIPPAGE_TIMEZONE=Asia/Dubai
# MONTHLY_SLIPPAGE_RUN_ON_START=false
# MONTHLY_SLIPPAGE_RECIPIENTS=

# MONTHLY_REVIEW_ENABLED=true
# MONTHLY_REVIEW_CRON=0 12 1 * *
# MONTHLY_REVIEW_TIMEZONE=Asia/Dubai
# MONTHLY_REVIEW_RUN_ON_START=false
# MONTHLY_REVIEW_RECIPIENTS=

# Closing Balance Report -- TRON wallets, each shown as its own row.
# TRON_WALLET_ADDRESS=<OwnBit wallet>
# TRON_WALLET_ADDRESS_2=TNteGan1r99nW3PoEb6PxQtnLFQ38vmnV5   # OwnBit New

# Records which reporting window each weekly report has already been sent for,
# so a server that recycles its app pool overnight cannot re-send one. Defaults
# to storage/weekly_report_sends.json, falling back to the temp dir when the
# site root is not writable (Plesk/IIS returns EPERM there).
# WEEKLY_REPORT_STATE_FILE=
#
# RUN_ON_START now fires at most ONCE per reporting window. It is still a
# testing flag -- remove it once you have seen the email.

# Trading backend (api.skylinkscapital.com) -- SERVER-SIDE ONLY, no VITE_ prefix.
#
# The backend answers every data endpoint with 401 invalid_token unless the
# request carries a Bearer, and that Bearer is not any of these values: it is a
# short-lived (one hour) access token minted by a client_credentials exchange at
# POST /oauth/token. wallet/backendToken.js runs that exchange, caches the
# token, and refreshes it a few minutes before it expires.
#
# BACKEND_CLIENT_ID and BACKEND_API_KEY are the two halves of ONE credential and
# are useless apart: the numeric client id is sent as client_id, the slc_live_
# key as client_secret. The key on its own produces a bare 500 from the token
# endpoint, so the exchange refuses to run without the client id and says which
# variable is missing instead. The key must never be sent to a data endpoint.
# BACKEND_CLIENT_ID=
# BACKEND_API_KEY=slc_live_...
#
# Optional. Leave unset and the `scope` parameter is omitted entirely, which is
# what asks the backend for this client's full grant; set it only to request a
# NARROWER slice than that (e.g. frontend).
# BACKEND_API_SCOPE=

# Live alerts hub watcher (alerts/hubWatcher.js).
#
# The watcher opens the SignalR hub at /ws/dashboard and emails on LP margin
# breaches. It authenticates with the SAME client_credentials token as above --
# BACKEND_CLIENT_ID + BACKEND_API_KEY are all it needs, and there is nothing
# extra to set here for authentication to work.
#
# SIGNALR_TOKEN is a legacy explicit override, kept only for anyone who has it
# set. Leave it UNSET: unset means the watcher mints a fresh one-hour token per
# negotiate and per reconnect, which is what a process running for weeks needs.
# A static token set here will expire and then be refused forever.
# SIGNALR_TOKEN=
#
# How long to wait before re-sending the "backend still down" alert while the
# connection cannot be re-established. Default 21600000 (6 hours). The watcher
# retries every 15 seconds, so this is the only thing standing between an
# outage and an email every 15 seconds -- do not set it small. 0 disables the
# reminder entirely (the first alert is still sent).
# BACKEND_DOWN_RENOTIFY_MS=21600000

# --- CRM events webhook (FXBO funnel -> Meta CAPI + WhatsApp + Brevo + ChatGPT Ads) ---
# crmSignup/README.md explains how the pieces fit together.
# Events are stored in the signup_events table, which is created at startup in
# the auth database. AUTH_DB_HOST, AUTH_DB_NAME, AUTH_DB_USER and
# AUTH_DB_PASSWORD (see "Server-side auth DB" above) must be set, or nothing is
# stored, every webhook is answered 503 and the retry sweeper does not start.
# Set META_CAPI_ACCESS_TOKEN, WA_API_KEY, BREVO_API_KEY and
# OPENAI_CONVERSIONS_API_KEY BEFORE pointing FXBO at the endpoint. A destination
# with no key is recorded as skipped, and a skipped row is final: setting the key
# later does not send it.
#
# **No variable of its own, and worth saying because its absence here looks
# like something missing: the first-deposit amount.** The `first_deposit` stage
# fetches the deposit value from FXBO, because Meta DISCARDS a Purchase that
# carries no value -- it answers 200 with events_received: 1 and the conversion
# never exists. That lookup reads API_TOKEN, API_VERSION and REST_PROXY_TARGET
# from the top of this file, the same three the /rest proxy reads, so there is
# nothing new to set and no second opinion about where the CRM is. It is NOT
# api.skylinkscapital.com and NOT BACKEND_API_KEY -- those are the trading
# backend. With API_TOKEN unset, that one stage records `failed` naming the
# variable (not `skipped`, so a resend reaches it); the other four stages, the
# WhatsApp welcome and the Brevo contact are unaffected. The call is bounded by
# CRM_SEND_TIMEOUT_MS below, like every other outbound call here.
#
# Required. The endpoint answers 401 to every request when this is unset or
# blank, and logs why once at startup. FXBO's rules must send this exact value
# in the Authorization header; "Bearer <value>" is rejected.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRM_WEBHOOK_SECRET=
# Meta Conversions API. The dataset id and API version are also the defaults in
# code. Unset token: Meta is skipped ("meta not configured").
META_DATASET_ID=692517170017822
META_CAPI_ACCESS_TOKEN=
META_API_VERSION=v26.0
# Set while testing so events land under Test events and touch no real data.
# UNSET THIS IN PRODUCTION.
META_TEST_EVENT_CODE=
# WhatsApp (DoubleTick). Unset key: WhatsApp is skipped ("whatsapp not
# configured"). Sent only at the "registered" stage, to anyone with a valid
# phone -- lead or client. Since 2026-10-14 the record type gates nothing here:
# a lead gets this same template, whose body and button both link to the login
# page below, which a lead has no account for. That was put to the user and sent
# anyway; there is no second template and no variable to pick one. The template,
# language, body, button and number below are also the defaults in code.
WA_API_KEY=
WA_TEMPLATE_NAME=registration_client_v3
WA_TEMPLATE_LANGUAGE=en
WA_TEMPLATE_BODY_PARAM=https://skylinkscapital.com/en/login/
WA_TEMPLATE_BUTTON_URL=https://skylinkscapital.com/en/login/
WA_FROM_NUMBER=+971507192185
# Attempts per message, minimum 1, five minutes apart. Meta and Brevo are fixed
# at 3 attempts.
WA_MAX_ATTEMPTS=3
# Delivery proof needs NO variable, which is worth saying because its absence
# here looks like something missing. A 2xx from DoubleTick means the request was
# accepted and `ENQUEUED` is their queue, not a handset -- and they have no
# endpoint to ask a message's status. It arrives only by their
# MESSAGE_STATUS_UPDATE webhook, pointed at POST /api/crm-events/whatsapp-status
# and registered by hand in their UI (CUTOVER step 7b). That endpoint takes no
# shared secret on purpose: their webhook has none to send, and the capability is
# the frozen whatsapp_request_id it matches on. Do not add a secret to the URL --
# see "Proving a message arrived" in crmSignup/README.md.
# Brevo's proof needs no variable either: the contact id comes out of the create
# call's own response and is stored in brevo_contact_id.
# Brevo contacts, at the "registered" stage only, and to clients only since
# 2026-10-14 -- a lead is skipped with "lead, not client". That gate is a
# POSITIVE test on the raw %client_is_lead% literal, so a value nobody
# recognises adds the contact rather than silently emptying the list; see
# "which way each gate fails" in crmSignup/README.md before changing it.
# BREVO_API_KEY is the same
# variable the alert emails use (see "Wallet report notifications" above, where
# it is commented out) and it is the one used for Contacts. Unset: Brevo is
# skipped ("brevo not configured").
# BREVO_LIST_ID has NO default in code, and since 2026-10-14 it fails CLOSED: if
# it is unset, blank or not a positive number, no request is made and the row
# records brevo_status = failed with a detail naming this variable. Terminal, not
# retried -- a wrong variable will not be right in five minutes -- and the row
# keeps its client data so the send can be retried once it is fixed. It used to
# fail open: the contact was created but joined no list while the row said
# "sent", so nobody found out until a campaign came up short. With BREVO_API_KEY
# set, the startup log says so at boot. 19 is the "All Clients" list.
BREVO_LIST_ID=19
# ChatGPT Ads (OpenAI's Conversions API). Server-side only: the browser pixel is
# the website's business. Unset key: ChatGPT Ads is skipped ("openai not
# configured").
#
# **The pixel id and the key both come from the ChatGPT Ads conversion setup
# screen and MUST belong to the same ad account.** A key paired with another
# account's pixel is refused over HTTP and recorded as `rejected` -- permanent,
# never retried -- so it reads like a defect rather than like a mismatch. Take
# both from the same screen in the same sitting; CUTOVER step 1b says how.
#
# Three stages actually produce a conversion today. `registered` is deliberately
# NOT sent -- the website pixel owns that conversion, and OpenAI merges a browser
# event with a server one only when the ids match, which ours cannot -- and
# `lead` has no FXBO trigger yet. See crmSignup/README.md.
OPENAI_CONVERSIONS_API_KEY=
# **Not OPENAI_API_KEY**, near the top of this file. That one is the LLM agent's,
# for a different OpenAI product. Two OpenAI keys live in this file and swapping
# them stops conversions silently.
#
# With the key set and this unset or blank there is no URL to post to, so every
# conversion records `skipped` with "openai pixel id not configured" -- and a
# skipped row is FINAL: setting this tomorrow does not send today's conversions
# and the resend control cannot reach them either. server.js warns at boot for
# exactly that reason. Not a secret: it is in the website's own pixel.
OPENAI_PIXEL_ID=
# The endpoint, so it can be moved without a deploy. Unset or blank is
# https://bzr.openai.com/v1/events, which is also the default in code. The pixel
# id travels on the query string as `pid`; the key travels in an Authorization
# header and never in a URL, so no request line can carry it into a log.
OPENAI_EVENTS_URL=
# A dry run: OpenAI validates the payload and records NOTHING.
#
# **On only for the literal `true` (any case), which is the INVERSE of
# CRM_EVENTS_WORKER_ENABLED's rule below** -- there, only the literal `false`
# turns the worker off. The inversion is deliberate, because the two fail in
# opposite directions. A value that wrongly read as "on" here would stop every
# conversion being recorded while every row still reads `sent`, and a validated
# request does not appear in OpenAI's event monitoring at all, so nothing outside
# the row's own detail would ever say so. Hence anything that is not `true` --
# `1`, `yes`, `on`, blank, a typo -- sends for real.
# The rows do record it, in the detail: "validate_only: nothing was recorded by
# OpenAI". Used by CUTOVER step 6b; unset in production.
OPENAI_VALIDATE_ONLY=
# Attempts per conversion, minimum 1, five minutes apart -- like WA_MAX_ATTEMPTS
# and unlike Meta and Brevo, which are fixed at 3. Anything unusable is 3.
# Retries are not free here the way they are elsewhere: every attempt has to land
# inside OpenAI's 7-day window, and a row whose budget runs out settles `failed`
# and can be resent only while it is still inside that window.
OPENAI_MAX_ATTEMPTS=3
# Comma-separated %custom_formname% values never sent a WhatsApp message.
# Matched case-insensitively, ignoring spaces around each value. It applies to a
# lead exactly as to a client -- it is one of the two facts about the person
# WhatsApp still refuses on, the other being the phone format.
# This does NOT gate Meta, Brevo or ChatGPT Ads.
SKIP_SOURCES=
# How long one outbound send, its reply included, may take before it is
# abandoned as a retryable failure, in milliseconds. Unset or blank is 10000.
# It also bounds the first-deposit amount lookup against FXBO, which is not a
# send but is held to the same rule for the same reason.
# A number outside 1000-120000 is moved to the nearer end of that range; a value
# that is not a positive number (30s, abc, 0) falls back to 10000. Either is
# warned about once per distinct value, on the first send after a start, not at
# startup. Node's fetch has no default timeout, and the sweeper runs rows
# serially, so one hung send would stall every row behind it.
CRM_SEND_TIMEOUT_MS=10000
# The retry sweeper. Each sweep takes at most the 25 oldest due rows. Only the
# word "false" (any case) turns it off; 0 or off leave it on. Turning it off
# stops every send, not only the timer: a newly stored event is answered 200 and
# left in the table, and the first sweep after it is turned back on sends it.
# This is the one safe way to pause sending during an incident -- removing a
# provider key stores `skipped`, which is final and is never resent.
CRM_EVENTS_WORKER_ENABLED=true
# Seconds between sweeps. Below 30 is raised to 30; 0 or anything unparseable
# is 60.
CRM_EVENTS_WORKER_INTERVAL_SECONDS=60
# ---------------------------------------------------------------------------
# Google Ads conversions, through the DATA MANAGER API
# ---------------------------------------------------------------------------
# The fifth destination for the CRM funnel, and since 2026-10-22 the only one
# that reports through an ASYNCHRONOUS API. Read this block before touching
# anything on it; the decisions are in crmSignup/googleAds.js.
#
# ** WHY IT MOVED. ** It used to call the Google Ads API's
# `ConversionUploadService.UploadClickConversions`. On 2026-10-22 a real
# conversion sent that way came back as HTTP 200 carrying
#   notAllowlistedError: CUSTOMER_NOT_ALLOWLISTED_FOR_THIS_FEATURE
#   -- New integrations for uploading click conversions should use the Data
#   Manager API.
# That restriction is not an access level and no approval clears it. Everything
# upstream of the call was proven working and is unchanged: OAuth, the token
# exchange, the resolution of a conversion action by NAME, the gclid captured
# from `full_link`, the value pair, and the classifier that correctly recorded
# `rejected` rather than `sent` for a 200 that carried an error.
#
# ** TWO APIs, AND BOTH ARE STILL CALLED. **
#   datamanager.googleapis.com -- where the conversion goes
#     POST /v1/events:ingest                  (one event per request)
#     GET  /v1/requestStatus:retrieve?requestId=...   (the real outcome)
#   googleads.googleapis.com -- ONE call, the conversion-action lookup
#     POST /<version>/customers/<id>/googleAds:search
#
# ** AN HTTP 200 FROM THE INGEST IS NOT A DELIVERED CONVERSION, AND THE ROW NO
# LONGER SAYS IT IS. ** The 200 means "accepted for asynchronous processing" and
# carries only a `requestId`. The real outcome -- SUCCESS, FAILED,
# PARTIAL_SUCCESS or still PROCESSING -- is retrieved by that id and Google says
# it "may take up to 24 hours" (some requests finish in about 30 minutes). So
# the destination has TWO phases, and a conversion spends the gap between them
# reading `retrying` on the CRM events tab, with the request id in its detail:
#
#   1. The ingest. One event, one request. The row is written `retrying` with
#      `google_request_id`, and the attempt counter restarts.
#   2. The confirmation, polled on Google's own published backoff -- 30 minutes,
#      then x1.3 a time capped at 60, for 25 polls spanning 24 hours. `SUCCESS`
#      is the ONLY thing that records `sent`. `FAILED` and `PARTIAL_SUCCESS`
#      record `rejected` naming Google's reasons; 24 hours of `PROCESSING`
#      records `failed` with a detail saying Google may still record it and that
#      nothing here will learn that it did.
#
# **So a healthy Google conversion reads `retrying` for up to a day, and the CRM
# events tab now says so in words rather than in red.** A Google row holding
# `retrying` WITH a `google_request_id` reads "awaiting Google" against the
# page's own "still going out" symbol, names the request, prints "we recorded
# retrying" under it, and is NOT counted by the "problems only" filter. One
# holding `retrying` with NO request id is an upload that failed and is being
# retried, and that one is still a problem. The request id is read from its own
# column -- it is in `listEventsSince`'s select list -- and deliberately not
# parsed back out of `google_detail`, where redactDetail masks any run of eight
# or more digits as a phone number. On the destination CARD, where a count cannot
# carry an id, Google's `retrying` is left unmarked and the card says why; the
# other four destinations' `retrying` stays red, because on them it really is a
# pile of failures.
#
# ** ONE EVENT PER REQUEST, DELIBERATELY. ** The API takes up to 2,000, and
# reports failures as `errorInfo.errorCounts[]` of {reason, recordCount} with NO
# per-record identifier. A batch of five coming back PARTIAL_SUCCESS with
# recordCount 2 would name no rows -- two of those conversions would not exist
# and nothing could say which. One event per request makes one requestId one
# conversion. The cost is request count, and it is nowhere near a limit: Google
# allows 300 requests a minute and 100,000 a day per Cloud project (the
# IngestionService holding its own allowance), and this service ingests on the
# order of ten conversions a day and polls each up to 25 times.
#
# ** THE SCRUB DOES NOT WAIT FOR GOOGLE. ** A row's client data is nulled about a
# minute after signup, once every destination has succeeded or been skipped --
# and a conversion Google has ACCEPTED counts as finished for that purpose, even
# though it is still `retrying`. (It did wait, for one day, 2026-10-22 to
# 2026-10-23: `retrying` is neither settled nor scrubbable, so every
# verified / live-account / first-deposit row carrying a gclid held its name,
# email and phone for up to 24 hours. That was a breach of the promise the data
# is kept under and it bought nothing, so it was reversed.)
#
# Nothing is lost by scrubbing early: `requestStatus:retrieve` takes
# `google_request_id` and NOTHING else off the row, that column is not client
# data and is deliberately not on the scrub list, so the confirmation polls
# across the scrub without noticing it. `processSignupEvent`'s scrubbed-row
# guard -- which settles every unsettled action `skipped`, because an action left
# unsettled is re-claimed for ever -- lets that one phase through for the same
# reason, so no conversion is ever recorded `skipped` after Google accepted it.
#
# The one cost, named: a conversion Google ultimately REFUSES settles `rejected`
# (or `failed`) on a row that was scrubbed hours earlier, and `requeueFailedSends`
# will not touch a scrubbed row -- so it sits under `scrubbed` on the Resend card
# rather than under `resendable`. A Google re-ingest would not need the scrubbed
# columns anyway (it needs the `gclid`, which survives), so widening the resend
# for this destination is available and is its own decision.
#
# ** WHAT IS ON THE WIRE. ** Each stage maps to a CONVERSION ACTION created in
# the Google Ads UI, named in `destinations[].productDestinationId` by its
# NUMERIC ID -- Google: "The ID of the Google Ads conversion action in the
# `operatingAccount` that receives the events", taken from the `id` field of
# `conversion_action` and NOT from its resource name. googleAds.js resolves that
# id from the action's NAME once per process, because a hardcoded id is
# unverifiable against the UI and wrong in the way nobody notices: it reports
# into whatever action now holds it. The three were created 2026-10-21 as
# "Website (Import from clicks)" actions -- type UPLOAD_CLICKS, which is what the
# Data Manager API requires for offline events -- with a 90-day click-through
# window and Count = One:
#   verified      -> FXBO_Client_Verified       (Qualified lead)
#   live_account  -> FXBO_Live_Account_Opened   (Converted lead)
#   first_deposit -> FXBO_First_Deposit         (Purchase, carries value)
# A name that does not resolve records `failed` naming the name, and nothing is
# ingested. Renaming one of these in the UI therefore stops that stage until the
# constant in googleAds.js is changed too -- and the resolved id is cached, so a
# fix needs a restart.
#
# `registered` is NOT reported -- the GTM container already fires
# Account_Registration (GADs) with enhanced conversions. One owner per stage, or
# every signup counts twice.
#
# Attribution needs a GCLID, which auto-tagging appends to the landing URL. That
# lands in the `full_link` we already store, so it is parsed exactly as `fbclid`
# is -- no website change was needed -- and frozen in its own column at the
# client's first event. **A client with no gclid cannot be attributed by this
# route at all** and records `skipped` saying so: the gclid goes in
# `adIdentifiers` and we send no `userData`, so there is no hashed-email
# fallback, and a conversion without one is counted against no campaign.
#
# Deduplication is `transactionId`, which is `<crm_client_id>:<stage>` -- the
# same identity Meta's `event_id` and OpenAI's event id are built from. It
# matters more than it did: the one window this service cannot close by itself is
# a process dying between the ingest leaving and `google_request_id` being
# written, and this id is what makes the repeat the same conversion rather than a
# second one.
#
# `consent` is NOT sent. Both `adUserData` and `adPersonalization` are documented
# optional and we have collected neither signal; sending CONSENT_GRANTED because
# the sample payload does would be a claim about the client nobody here can make.
# If Google ever requires it, the polls say so with
# PROCESSING_ERROR_REASON_DENIED_CONSENT, which is visible in the row's detail.
#
# ** THE SCOPE IS DIFFERENT FROM THE GOOGLE ADS API's, AND THIS IS THE FAILURE
# TO EXPECT FIRST. ** The Data Manager API needs
# https://www.googleapis.com/auth/datamanager, which
# scripts/google-ads-refresh-token.mjs now requests alongside `adwords` in one
# consent. **A refresh token minted before 2026-10-22 carries only `adwords`, and
# scopes are not additive on an existing token.** Such a token resolves
# conversion actions perfectly and is refused by every ingest with
# ACCESS_TOKEN_SCOPE_INSUFFICIENT in the row's detail. The fix is to re-run that
# script and replace GOOGLE_ADS_REFRESH_TOKEN below.
#
# The other named failures, each with its own fix:
#   SERVICE_DISABLED -- the Data Manager API is not enabled on the Cloud project
#     that owns the OAuth client. Enable it in the Cloud Console.
#   PERMISSION_DENIED on the operating account -- the authorising user cannot
#     reach it, or reaches it through a manager this configuration does not name.
#     Google is stricter for the status retrieval than for the ingest: the SAME
#     access path, GOOGLE_ADS_LOGIN_CUSTOMER_ID included, and Read-only access is
#     refused (Admin or Standard is required).
#   RESOURCE_EXHAUSTED -- the project quota. It arrives as a 429 and is retried.
#
# ** NO DEVELOPER TOKEN ANYWHERE. GOOGLE_ADS_DEVELOPER_TOKEN IS NO LONGER READ. **
# Setting it does nothing at all; it is documented here only so that nobody
# re-adds it. Two reasons, not one: Google Ads sunset developer tokens on
# 2026-09-09 ("You can continue sending developer tokens in your API call
# headers, but this is optional and ignored by the API servers", and they "will
# start rejecting developer tokens in API calls in a future major version"), and
# the Data Manager API documents no such header at all -- its destinations guide
# says "Don't set request headers in an `IngestionService` request". A header that
# is ignored today and refused tomorrow is not a bridge worth keeping. Access to
# both APIs is the ACCESS LEVEL of the Google Cloud project that owns the OAuth
# client, granted in the Cloud Console; the API Center's application form is
# legacy and Google says a request made there "won't be processed".
#
# The OAuth client. Desktop type, project `skylinkscapital`, deliberately NOT
# the Sheets client -- revoking one must not break the other.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Minted once by scripts/google-ads-refresh-token.mjs, which writes it here and
# requests BOTH scopes in one consent (see above -- a token minted before
# 2026-10-22 cannot ingest).
# **This is the value that stands for "the destination is configured"**: unset,
# every row records `skipped` with "google ads not configured", exactly as a
# missing META_CAPI_ACCESS_TOKEN or OPENAI_CONVERSIONS_API_KEY does.
# It survives indefinitely ONLY because the OAuth consent screen was published
# to "In production" on 2026-10-21. While that screen sits in "Testing", Google
# expires refresh tokens after 7 days, and every conversion then settles
# `failed` at the exchange with `invalid_grant` in its detail -- permanent, not
# retried, because it will not be right in five minutes.
GOOGLE_ADS_REFRESH_TOKEN=
# Sky Links Capital L.L.C, digits only. It is `operatingAccount.accountId` in the
# ingest body now rather than part of a URL, and Google's instruction for it is
# "your 10-digit Google Ads customer ID (without hyphens)" -- the sender strips
# dashes so a value pasted from the UI still works. With the refresh token set
# and this unset every conversion records `skipped`, and a skipped row is FINAL:
# setting it tomorrow does not report today's conversions and the resend control
# cannot reach them either. server.js warns at boot for exactly that reason.
GOOGLE_ADS_CUSTOMER_ID=4743067250
# The manager account the requests are made THROUGH, digits only. Still read, and
# now read for TWO things in two shapes: the `login-customer-id` HEADER on the
# conversion-action lookup (a Google Ads API call, which still takes headers) and
# `destinations[].loginAccount` in the ingest BODY (the Data Manager API takes
# none). Required only when reaching the customer through that manager; leave
# blank while the authorising user has direct access to the account above -- both
# are then omitted entirely, which defaults to the operating account. A wrong one
# is a PERMISSION_DENIED, and it also has to be right for the status retrieval,
# which Google requires to use the same access path as the ingest.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# The GOOGLE ADS API version, in the path of the one call still made to it (the
# conversion-action lookup). Unset is the default in code, v26, released
# 2026-10-14. **This is a value that expires**: Google releases a version every
# three or four months and sunsets each about a year after its release, and a
# sunset version stops answering rather than degrading -- so this exists to be
# moved with a restart rather than a deploy.
#
# There is deliberately NO equivalent for the Data Manager API. It has shipped
# exactly one path, v1, since going generally available on 2025-12-09; its
# releases are minor (v1.3, v1.6, v1.8) and none of them changes the path or
# retires the one before it. An env var for it would be a knob whose only use is
# to break the integration.
GOOGLE_ADS_API_VERSION=
# The timezone offset written into `eventTimestamp`, in the form `+hh:mm`. Unset
# is +04:00, the ACCOUNT's own zone (Gulf Standard Time), and that is the value
# to leave it at. Anything that is not a signed +hh:mm (a zone name, `Z`, `+04`)
# falls back to +04:00 with a warning rather than stopping the conversions,
# because the account's own offset is the correct value and this variable exists
# only to move off it.
#
# **It is PRESENTATIONAL now, and that changed with the API.**
# `conversionDateTime` on the old upload was a LOCAL WALL CLOCK whose offset told
# Google which instant the digits beside it named, so a wrong one moved a
# conversion by a DAY at the boundary. `eventTimestamp` is an RFC 3339 Timestamp,
# which is an INSTANT: 2026-10-22T02:30:00+04:00 and 2026-10-21T22:30:00Z are the
# same moment and Google files them identically, converting to the account's zone
# for reporting from the account's OWN setting. So this offset decides how the
# timestamp reads to a person, not which day the conversion lands on. It is kept
# because a stamp a reader can compare to the Google Ads UI without arithmetic is
# worth having.
GOOGLE_ADS_TIMEZONE_OFFSET=
# Sends the ingest with Google's validateOnly flag: the request "is validated but
# not executed, and only errors are returned". The parallel to
# OPENAI_VALIDATE_ONLY above, and it carries the same hazard in a sharper form --
# **a validated request is now the ONLY path on which an ingest records `sent`**,
# because nothing was executed and so there is no request to confirm. A real
# conversion passing through while this is on is therefore recorded `sent` and
# the resend control cannot reach a `sent` row. The row's detail says so
# ("validate_only: nothing was recorded by Google Ads"). Use it for one
# deliberate test, then unset it and restart. Only the literal "true" (any case)
# turns it on, which is the same inversion OPENAI_VALIDATE_ONLY uses and for the
# same reason: a `1`, `yes` or `on` left here must not be what silently stops
# every conversion.
GOOGLE_ADS_VALIDATE_ONLY=
# The three endpoints, so any of them can be moved without a deploy. Unset they
# are https://datamanager.googleapis.com (the ingest and the status retrieval),
# https://googleads.googleapis.com (the conversion-action lookup) and
# https://oauth2.googleapis.com/token, which are also the defaults in code. Two
# hosts for Google rather than one, because they are two APIs and a single value
# pointing at both would be one setting for two services. Every secret travels in
# a header or a form body and never in a URL, and so does the gclid, so no
# request line can carry one into a log.
GOOGLE_DATA_MANAGER_HOST=
GOOGLE_ADS_API_HOST=
GOOGLE_ADS_TOKEN_URL=
# NO LONGER READ (see above). Kept here, empty, so that nobody re-adds it:
# ignored by the Google Ads API since 2026-09-09 and due to be rejected, and
# undocumented on the Data Manager API, which takes no request headers on an
# ingest at all.
GOOGLE_ADS_DEVELOPER_TOKEN=
