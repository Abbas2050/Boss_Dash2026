# MT5 API Configuration (Production)
# In production, set this to your PHP backend URL
# Example: https://yourdomain.com/mt5_api.php
VITE_MT5_API_URL=

# Base backend URL (used for SignalR + backend API endpoints in dev/proxy bypass cases)
# Example: https://api.skylinkscapital.com
VITE_BACKEND_BASE_URL=

# CRM / wallet / AI secrets -- SERVER-SIDE ONLY, no VITE_ prefix.
#
# Vite publishes every VITE_-prefixed variable to the browser bundle, so the
# prefix must never appear on a credential. These are read by server.js, which
# attaches the CRM token to the authenticated /rest proxy on the browser's
# behalf. Renaming any of these back to VITE_* re-opens the leak.
#
# Example: https://portal.skylinkscapital.com/rest/transactions
API_URL=
API_VERSION=1.0.0
API_TOKEN=
WALLET_URL=
WALLET_TOKEN=
WALLET_API_TOKEN=
OPENAI_API_KEY=
# Where the /rest proxy forwards to. Defaults to portal.skylinkscapital.com.
# REST_PROXY_TARGET=

# Wallet report notifications (email + Telegram)
# BREVO_API_KEY=
# EMAIL_FROM=noreply@skylinkscapital.com
# BREVO_API_KEY=
# DEALMATCH_ALERT_RECIPIENTS=you@company.com,team@company.com
# WEEKLY_DEALMATCH_ENABLED=true
# WEEKLY_DEALMATCH_CRON=0 9 * * 6
# WEEKLY_DEALMATCH_TIMEZONE=Asia/Dubai
# WEEKLY_DEALMATCH_RUN_ON_START=false
# WALLET_RECIPIENTS=ops@example.com,finance@example.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=-1000000000000
#
# Wallet scheduler modes:
# - daily (default): sends once daily at WALLET_REPORT_CRON (UTC)
# - on-change: checks balances on WALLET_REPORT_ON_CHANGE_CRON and sends only when tracked balances/total change
# WALLET_REPORT_MODE=daily
# WALLET_REPORT_CRON=0 8 * * *
# WALLET_REPORT_ON_CHANGE_CRON=*/5 * * * *
# WALLET_REPORT_RUN_ON_START=true
# WALLET_REPORT_SEND_ON_FIRST_RUN=false
# WALLET_REPORT_STATE_FILE=storage/wallet_report_state.json

# Server-side GA4 settings (used by server.js/api.js/ga4.js)
# GA4_PROPERTY_ID=476328175
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional fallback: file path on server (not committed)
# GA4_KEY_FILE=/absolute/path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# DEBUG_GA4=0

# FAB Operating / Holding balances for the Excess Funds cards.
# A SEPARATE workbook from GOOGLE_SHEETS_ID -- unrelated sheet, unrelated layout.
# It is read with the same service account (GA4_SERVICE_ACCOUNT_JSON), so the
# sheet must be shared with that account's client_email as a Viewer or the read
# fails with a 403 naming the address.
# The tab and the two cell addresses live in storage/fab_accounts_mapping.json,
# so a row inserted in the sheet is fixed by editing config, not by deploying.
# FAB_ACCOUNTS_SHEET_ID=

# Server-side auth DB + JWT
# AUTH_DB_HOST=localhost
# AUTH_DB_PORT=3306
# AUTH_DB_NAME=bossdash_auth
# AUTH_DB_USER=bossdash_user
# AUTH_DB_PASSWORD=change_me
# AUTH_JWT_SECRET=replace_with_long_random_secret
# AUTH_JWT_EXPIRES_IN=12h
# AUTH_SEED_NAME=Abbas
# AUTH_SEED_EMAIL=abbas@skylinks.capital
# AUTH_SEED_PASSWORD=admin123

# DocuSign integration (FXBO approved application -> envelope send)
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# DOCUSIGN_TEMPLATE_ID=
# DOCUSIGN_TEMPLATE_ROLE=Signer
# DOCUSIGN_EMAIL_SUBJECT=Please sign your application document
# DOCUSIGN_AUTH_BASE=account-d.docusign.com
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_BASE_URI=
# DOCUSIGN_FXBO_WEBHOOK_BEARER=
# DOCUSIGN_CONNECT_HMAC_SECRET=
# DOCUSIGN_AUTO_SYNC_ENABLED=false
# DOCUSIGN_AUTO_SYNC_INTERVAL_SECONDS=300
# DOCUSIGN_AUTO_SYNC_RUN_ON_START=true
# DOCUSIGN_SYNC_LOOKBACK_MINUTES=6

# Optional: If you want to override the default MT5 server settings
# These are already configured in mt5_api.php, but you can override them here
# MT5_SERVER=mt5.skylinkstrader.com:443
# MT5_LOGIN=1023
# MT5_BUILD=4330

# Weekly Slippage Report -- LP slippage buckets across trading pairs. Also
# backs the daily and monthly Slippage cadences (reports/schedulers.js):
# their _RECIPIENTS vars fall back to this one, so without it all three
# Slippage cadences have no recipients.
# WITHOUT SLIPPAGE_ALERT_RECIPIENTS THE REPORT SILENTLY SKIPS: the scheduler
# fires, logs "No recipients configured", and sends nothing.
# SLIPPAGE_ALERT_RECIPIENTS=you@company.com,team@company.com
# WEEKLY_SLIPPAGE_ENABLED=true
# WEEKLY_SLIPPAGE_CRON=30 9 * * 6
# WEEKLY_SLIPPAGE_TIMEZONE=Asia/Dubai
# WEEKLY_SLIPPAGE_RUN_ON_START=false

# Weekly Business Summary -- money movement and account activity.
# WITHOUT SUMMARY_ALERT_RECIPIENTS THE REPORT SILENTLY SKIPS: the scheduler
# fires, logs "No recipients configured", and sends nothing.
# SUMMARY_ALERT_RECIPIENTS=you@company.com,team@company.com
# WEEKLY_SUMMARY_ENABLED=true
# WEEKLY_SUMMARY_CRON=0 10 * * 6
# WEEKLY_SUMMARY_TIMEZONE=Asia/Dubai
# WEEKLY_SUMMARY_RUN_ON_START=false
# SUMMARY_LARGE_DEPOSIT_THRESHOLD=1000
# SUMMARY_TX_STATUSES=approved

# ── Report schedules ────────────────────────────────────────────────────────
# Three reports x three cadences. Times are Asia/Dubai. Ordering within a
# cadence is deliberate: Deal Match, then Slippage, then Business Summary --
# the Business Summary computes Total Revenue from DealMatch/Run and must not
# run first.
#
# Dailies run Tue-Sat (cron 2-6), each covering the previous day, so every
# trading day gets one daily and nothing fires for a shut market.
# Monthlies run after the weeklies so a 1st that falls on a Saturday does not
# fire two reports in the same minute.
#
# Every _RECIPIENTS below falls back to that report's *_ALERT_RECIPIENTS
# (DEALMATCH_ALERT_RECIPIENTS / SLIPPAGE_ALERT_RECIPIENTS /
# SUMMARY_ALERT_RECIPIENTS, set above), so all six here work with no change
# to this file once the ALERT_RECIPIENTS vars are set. The three weekly
# cadences (WEEKLY_DEALMATCH_*, WEEKLY_SLIPPAGE_*, WEEKLY_SUMMARY_*,
# documented above) have no dedicated _RECIPIENTS var and use the
# ALERT_RECIPIENTS vars directly -- so all nine work off the same three
# ALERT_RECIPIENTS settings.

# DAILY_DEALMATCH_ENABLED=true
# DAILY_DEALMATCH_CRON=0 7 * * 2-6
# DAILY_DEALMATCH_TIMEZONE=Asia/Dubai
# DAILY_DEALMATCH_RUN_ON_START=false
# DAILY_DEALMATCH_RECIPIENTS=

# DAILY_SLIPPAGE_ENABLED=true
# DAILY_SLIPPAGE_CRON=30 7 * * 2-6
# DAILY_SLIPPAGE_TIMEZONE=Asia/Dubai
# DAILY_SLIPPAGE_RUN_ON_START=false
# DAILY_SLIPPAGE_RECIPIENTS=

# DAILY_DIGEST_ENABLED=true
# DAILY_DIGEST_CRON=0 8 * * 2-6
# DAILY_DIGEST_TIMEZONE=Asia/Dubai
# DAILY_DIGEST_RUN_ON_START=false
# DAILY_DIGEST_RECIPIENTS=

# MONTHLY_DEALMATCH_ENABLED=true
# MONTHLY_DEALMATCH_CRON=0 11 1 * *
# MONTHLY_DEALMATCH_TIMEZONE=Asia/Dubai
# MONTHLY_DEALMATCH_RUN_ON_START=false
# MONTHLY_DEALMATCH_RECIPIENTS=

# MONTHLY_SLIPPAGE_ENABLED=true
# MONTHLY_SLIPPAGE_CRON=30 11 1 * *
# MONTHLY_SLIPPAGE_TIMEZONE=Asia/Dubai
# MONTHLY_SLIPPAGE_RUN_ON_START=false
# MONTHLY_SLIPPAGE_RECIPIENTS=

# MONTHLY_REVIEW_ENABLED=true
# MONTHLY_REVIEW_CRON=0 12 1 * *
# MONTHLY_REVIEW_TIMEZONE=Asia/Dubai
# MONTHLY_REVIEW_RUN_ON_START=false
# MONTHLY_REVIEW_RECIPIENTS=

# Closing Balance Report -- TRON wallets, each shown as its own row.
# TRON_WALLET_ADDRESS=<OwnBit wallet>
# TRON_WALLET_ADDRESS_2=TNteGan1r99nW3PoEb6PxQtnLFQ38vmnV5   # OwnBit New

# Records which reporting window each weekly report has already been sent for,
# so a server that recycles its app pool overnight cannot re-send one. Defaults
# to storage/weekly_report_sends.json, falling back to the temp dir when the
# site root is not writable (Plesk/IIS returns EPERM there).
# WEEKLY_REPORT_STATE_FILE=
#
# RUN_ON_START now fires at most ONCE per reporting window. It is still a
# testing flag -- remove it once you have seen the email.

# Trading backend (api.skylinkscapital.com) -- SERVER-SIDE ONLY, no VITE_ prefix.
#
# The backend answers every data endpoint with 401 invalid_token unless the
# request carries a Bearer, and that Bearer is not any of these values: it is a
# short-lived (one hour) access token minted by a client_credentials exchange at
# POST /oauth/token. wallet/backendToken.js runs that exchange, caches the
# token, and refreshes it a few minutes before it expires.
#
# BACKEND_CLIENT_ID and BACKEND_API_KEY are the two halves of ONE credential and
# are useless apart: the numeric client id is sent as client_id, the slc_live_
# key as client_secret. The key on its own produces a bare 500 from the token
# endpoint, so the exchange refuses to run without the client id and says which
# variable is missing instead. The key must never be sent to a data endpoint.
# BACKEND_CLIENT_ID=
# BACKEND_API_KEY=slc_live_...
#
# Optional. Leave unset and the `scope` parameter is omitted entirely, which is
# what asks the backend for this client's full grant; set it only to request a
# NARROWER slice than that (e.g. frontend).
# BACKEND_API_SCOPE=

# Live alerts hub watcher (alerts/hubWatcher.js).
#
# The watcher opens the SignalR hub at /ws/dashboard and emails on LP margin
# breaches. It authenticates with the SAME client_credentials token as above --
# BACKEND_CLIENT_ID + BACKEND_API_KEY are all it needs, and there is nothing
# extra to set here for authentication to work.
#
# SIGNALR_TOKEN is a legacy explicit override, kept only for anyone who has it
# set. Leave it UNSET: unset means the watcher mints a fresh one-hour token per
# negotiate and per reconnect, which is what a process running for weeks needs.
# A static token set here will expire and then be refused forever.
# SIGNALR_TOKEN=
#
# How long to wait before re-sending the "backend still down" alert while the
# connection cannot be re-established. Default 21600000 (6 hours). The watcher
# retries every 15 seconds, so this is the only thing standing between an
# outage and an email every 15 seconds -- do not set it small. 0 disables the
# reminder entirely (the first alert is still sent).
# BACKEND_DOWN_RENOTIFY_MS=21600000
