# MT5 API Configuration (Production)
# In production, set this to your PHP backend URL
# Example: https://yourdomain.com/mt5_api.php
VITE_MT5_API_URL=

# Base backend URL (used for SignalR + backend API endpoints in dev/proxy bypass cases)
# Example: https://api.skylinkscapital.com
VITE_BACKEND_BASE_URL=

# CRM / wallet / AI secrets -- SERVER-SIDE ONLY, no VITE_ prefix.
#
# Vite publishes every VITE_-prefixed variable to the browser bundle, so the
# prefix must never appear on a credential. These are read by server.js, which
# attaches the CRM token to the authenticated /rest proxy on the browser's
# behalf. Renaming any of these back to VITE_* re-opens the leak.
#
# Example: https://portal.skylinkscapital.com/rest/transactions
API_URL=
API_VERSION=1.0.0
API_TOKEN=
WALLET_URL=
WALLET_TOKEN=
WALLET_API_TOKEN=
OPENAI_API_KEY=
# Where the /rest proxy forwards to. Defaults to portal.skylinkscapital.com.
# REST_PROXY_TARGET=

# Wallet report notifications (email + Telegram)
# BREVO_API_KEY=
# EMAIL_FROM=noreply@skylinkscapital.com
# BREVO_API_KEY=
# DEALMATCH_ALERT_RECIPIENTS=you@company.com,team@company.com
# WEEKLY_DEALMATCH_ENABLED=true
# WEEKLY_DEALMATCH_CRON=0 9 * * 6
# WEEKLY_DEALMATCH_TIMEZONE=Asia/Dubai
# WEEKLY_DEALMATCH_RUN_ON_START=false
# WALLET_RECIPIENTS=ops@example.com,finance@example.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=-1000000000000
#
# Wallet scheduler modes:
# - daily (default): sends once daily at WALLET_REPORT_CRON (UTC)
# - on-change: checks balances on WALLET_REPORT_ON_CHANGE_CRON and sends only when tracked balances/total change
# WALLET_REPORT_MODE=daily
# WALLET_REPORT_CRON=0 8 * * *
# WALLET_REPORT_ON_CHANGE_CRON=*/5 * * * *
# WALLET_REPORT_RUN_ON_START=true
# WALLET_REPORT_SEND_ON_FIRST_RUN=false
# WALLET_REPORT_STATE_FILE=storage/wallet_report_state.json

# Server-side GA4 settings (used by server.js/api.js/ga4.js)
# GA4_PROPERTY_ID=476328175
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional fallback: file path on server (not committed)
# GA4_KEY_FILE=/absolute/path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# DEBUG_GA4=0

# Server-side auth DB + JWT
# AUTH_DB_HOST=localhost
# AUTH_DB_PORT=3306
# AUTH_DB_NAME=bossdash_auth
# AUTH_DB_USER=bossdash_user
# AUTH_DB_PASSWORD=change_me
# AUTH_JWT_SECRET=replace_with_long_random_secret
# AUTH_JWT_EXPIRES_IN=12h
# AUTH_SEED_NAME=Abbas
# AUTH_SEED_EMAIL=abbas@skylinks.capital
# AUTH_SEED_PASSWORD=admin123

# DocuSign integration (FXBO approved application -> envelope send)
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# DOCUSIGN_TEMPLATE_ID=
# DOCUSIGN_TEMPLATE_ROLE=Signer
# DOCUSIGN_EMAIL_SUBJECT=Please sign your application document
# DOCUSIGN_AUTH_BASE=account-d.docusign.com
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_BASE_URI=
# DOCUSIGN_FXBO_WEBHOOK_BEARER=
# DOCUSIGN_CONNECT_HMAC_SECRET=
# DOCUSIGN_AUTO_SYNC_ENABLED=false
# DOCUSIGN_AUTO_SYNC_INTERVAL_SECONDS=300
# DOCUSIGN_AUTO_SYNC_RUN_ON_START=true
# DOCUSIGN_SYNC_LOOKBACK_MINUTES=6

# Optional: If you want to override the default MT5 server settings
# These are already configured in mt5_api.php, but you can override them here
# MT5_SERVER=mt5.skylinkstrader.com:443
# MT5_LOGIN=1023
# MT5_BUILD=4330

# Weekly Business Summary -- money movement and account activity.
# WITHOUT SUMMARY_ALERT_RECIPIENTS THE REPORT SILENTLY SKIPS: the scheduler
# fires, logs "No recipients configured", and sends nothing.
# SUMMARY_ALERT_RECIPIENTS=you@company.com,team@company.com
# WEEKLY_SUMMARY_ENABLED=true
# WEEKLY_SUMMARY_CRON=0 10 * * 6
# WEEKLY_SUMMARY_TIMEZONE=Asia/Dubai
# WEEKLY_SUMMARY_RUN_ON_START=false
# SUMMARY_LARGE_DEPOSIT_THRESHOLD=1000
# SUMMARY_TX_STATUSES=approved

# Daily Digest -- yesterday in five short sections, no charts.
# Sent EVERY morning including weekends: a quiet day and a dead scheduler must
# not look the same. Recipients fall back to SUMMARY_ALERT_RECIPIENTS, so the
# default audience is whoever gets the weekly summary.
# DAILY_DIGEST_ENABLED=true
# DAILY_DIGEST_CRON=0 8 * * *
# DAILY_DIGEST_TIMEZONE=Asia/Dubai
# DAILY_DIGEST_RUN_ON_START=false
# DAILY_DIGEST_RECIPIENTS=

# Monthly Business Review -- the weekly summary over a calendar month, plus
# month-over-month and week-by-week. Sends 10:00 on the 1st, which lands on a
# weekend twice a year; it sends anyway. Recipients fall back to
# SUMMARY_ALERT_RECIPIENTS.
# MONTHLY_REVIEW_ENABLED=true
# MONTHLY_REVIEW_CRON=0 10 1 * *
# MONTHLY_REVIEW_TIMEZONE=Asia/Dubai
# MONTHLY_REVIEW_RUN_ON_START=false
# MONTHLY_REVIEW_RECIPIENTS=

# Closing Balance Report -- TRON wallets, each shown as its own row.
# TRON_WALLET_ADDRESS=<OwnBit wallet>
# TRON_WALLET_ADDRESS_2=TNteGan1r99nW3PoEb6PxQtnLFQ38vmnV5   # OwnBit New

# Records which reporting window each weekly report has already been sent for,
# so a server that recycles its app pool overnight cannot re-send one. Defaults
# to storage/weekly_report_sends.json, falling back to the temp dir when the
# site root is not writable (Plesk/IIS returns EPERM there).
# WEEKLY_REPORT_STATE_FILE=
#
# RUN_ON_START now fires at most ONCE per reporting window. It is still a
# testing flag -- remove it once you have seen the email.
