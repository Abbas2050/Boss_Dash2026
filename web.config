<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <!--
      Which files a deploy must touch for iisnode to reload the app.

      iisnode's default is "*.js;iisnode.yml", and that matches the app ROOT
      only. server.js pulls its real work out of alerts/, auth/, reports/ and
      wallet/ via static ESM imports, which Node evaluates once at process
      start - so a deploy that changed only, say, reports/dealMatchWeeklyReport.js
      left server.js untouched, triggered no recycle, and the running process
      kept serving the module it loaded at boot. The files on disk were new and
      the emails were old, with nothing anywhere to say why.

      Listing those four directories makes a deploy to any of them recycle the
      app the way a change to server.js already did. The patterns are one level
      deep because those directories are flat; a new subdirectory of server-side
      code needs its own entry here.
    -->
    <iisnode watchedFiles="web.config;*.js;alerts\*.js;auth\*.js;reports\*.js;wallet\*.js" />
    <security>
      <requestFiltering>
        <verbs allowUnlisted="true">
          <clear />
          <remove verb="PUT" />
          <remove verb="DELETE" />
          <remove verb="PATCH" />
          <remove verb="OPTIONS" />
          <add verb="PUT" allowed="true" />
          <add verb="DELETE" allowed="true" />
          <add verb="PATCH" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <rewrite>
      <rules>
        <rule name="Route to Express" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
